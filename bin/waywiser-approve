#!/data/data/com.termux/files/usr/bin/env node
/**
 * waywiser-approve — permission-response callback. Called by the notification
 * action string after termux-fingerprint returns a decision. argv[3] is
 * literally "yes" or "no"; any other value is treated as "no" (deny).
 *
 * Usage:  waywiser-approve <token> yes|no
 */
import * as fs from "node:fs";
import * as path from "node:path";
import { randomBytes } from "node:crypto";

const HEX_TOKEN_RE = /^[a-f0-9-]{16,}$/i;

const HOME = process.env.WAYWISER_HOME || path.join(process.env.HOME || ".", ".waywiser");
const TOKENS = path.join(HOME, "mobile", "tokens");
const MSGS = path.join(HOME, "mobile", "msgs");

function die(msg) {
	process.stderr.write(`waywiser-approve: ${msg}\n`);
	process.exit(2);
}

const token = process.argv[2];
const decision = String(process.argv[3] ?? "no").toLowerCase() === "yes" ? "approve" : "deny";
if (!token || !HEX_TOKEN_RE.test(token)) die(`invalid token: ${JSON.stringify(token ?? "")}`);

fs.mkdirSync(MSGS, { recursive: true });
let requestId = token;
try {
	const p = path.join(TOKENS, `${token}.json`);
	const raw = fs.readFileSync(p, "utf-8");
	const parsed = JSON.parse(raw);
	if (parsed?.intent?.kind === "approve" || parsed?.intent?.kind === "deny") {
		requestId = String(parsed.intent.requestId ?? token);
	}
	try { fs.unlinkSync(p); } catch {}
} catch {}

const msg = {
	token,
	kind: decision, // "approve" | "deny"
	receivedAtMs: Date.now(),
	extra: { requestId },
};
const name = `${Date.now().toString(36)}-${randomBytes(4).toString("hex")}.json`;
const tmp = path.join(MSGS, `${name}.tmp`);
fs.writeFileSync(tmp, JSON.stringify(msg));
fs.renameSync(tmp, path.join(MSGS, name));
