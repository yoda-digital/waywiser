#!/usr/bin/env bash
# waywiser — personal AI agent on the Pi harness.
# Thin wrapper: sets up ~/.waywiser (identity, memory, board, brain), discovers
# additional plugins from plugins/, and launches pi with everything wired up.
set -euo pipefail

WAYWISER_HOME="${WAYWISER_HOME:-$HOME/.waywiser}"
export WAYWISER_HOME
WAYWISER_PKG_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# ── First-run bootstrap ───────────────────────────────────────────────
mkdir -p "$WAYWISER_HOME" "$WAYWISER_HOME/skills"

touch "$WAYWISER_HOME/MEMORY.md" "$WAYWISER_HOME/USER.md"
if [ ! -f "$WAYWISER_HOME/SOUL.md" ]; then
	cp "$WAYWISER_PKG_DIR/config/SOUL.md" "$WAYWISER_HOME/SOUL.md"
	echo "waywiser: created default identity at $WAYWISER_HOME/SOUL.md" >&2
fi

# Bootstrap PA playbooks (non-destructive: only copies new skills, never overwrites)
for skill_dir in "$WAYWISER_PKG_DIR/skills/"pa-*/; do
	[ -d "$skill_dir" ] || continue
	skill_name="$(basename "$skill_dir")"
	if [ ! -f "$WAYWISER_HOME/skills/$skill_name/SKILL.md" ]; then
		mkdir -p "$WAYWISER_HOME/skills/$skill_name"
		cp "$skill_dir/SKILL.md" "$WAYWISER_HOME/skills/$skill_name/SKILL.md"
		echo "waywiser: installed PA playbook $skill_name" >&2
	fi
done

# ── Brain setup (core component — always loaded via extensions/index.ts) ──
# Brain directories
mkdir -p "$WAYWISER_HOME/brain" \
	"$WAYWISER_HOME/skills/active" \
	"$WAYWISER_HOME/skills/candidates" \
	"$WAYWISER_HOME/skills/retired"

# Brain config (first-run bootstrap from example)
if [ -f "$WAYWISER_PKG_DIR/config/brain.example.json" ] && [ ! -f "$WAYWISER_HOME/brain.json" ]; then
	cp "$WAYWISER_PKG_DIR/config/brain.example.json" "$WAYWISER_HOME/brain.json"
	echo "waywiser: created default brain.json" >&2
fi

# Mobile (Termux) config (first-run bootstrap from example)
if [ -f "$WAYWISER_PKG_DIR/config/mobile.example.json" ] && [ ! -f "$WAYWISER_HOME/mobile.json" ]; then
	cp "$WAYWISER_PKG_DIR/config/mobile.example.json" "$WAYWISER_HOME/mobile.json"
	echo "waywiser: created default mobile.json" >&2
fi

# Mobile: create ~/.waywiser/mobile/{tokens,msgs} so the inbox works on first launch
mkdir -p "$WAYWISER_HOME/mobile/tokens" "$WAYWISER_HOME/mobile/msgs"

# ── Additional plugin discovery (for future plugins, NOT Brain) ──────
PLUGIN_ARGS=()
PLUGINS_DIR="$WAYWISER_PKG_DIR/plugins"

if [ -d "$PLUGINS_DIR" ]; then
	for plugin_dir in "$PLUGINS_DIR"/*/; do
		[ -d "$plugin_dir" ] || continue
		plugin_name="$(basename "$plugin_dir")"

		# First-run: copy example configs to WAYWISER_HOME
		if [ -d "${plugin_dir}config" ]; then
			for example in "${plugin_dir}config/"*.example.json; do
				[ -f "$example" ] || continue
				target_name="$(basename "$example" .example.json).json"
				if [ ! -f "$WAYWISER_HOME/$target_name" ]; then
					cp "$example" "$WAYWISER_HOME/$target_name"
					echo "waywiser: created default $target_name from $plugin_name plugin" >&2
				fi
			done
		fi

		# Discover extensions (extensions/<subdir>/index.ts)
		if [ -d "${plugin_dir}extensions" ]; then
			for ext_dir in "${plugin_dir}extensions/"*/; do
				[ -d "$ext_dir" ] || continue
				if [ -f "${ext_dir}index.ts" ]; then
					PLUGIN_ARGS+=(--extension "${ext_dir}index.ts")
				fi
			done
		fi

		# Discover skills (skills/<subdir>/SKILL.md)
		if [ -d "${plugin_dir}skills" ]; then
			for skill_dir in "${plugin_dir}skills/"*/; do
				[ -d "$skill_dir" ] || continue
				if [ -f "${skill_dir}SKILL.md" ]; then
					PLUGIN_ARGS+=(--skill "${skill_dir}SKILL.md")
				fi
			done
		fi
	done
fi

# ── Launch ────────────────────────────────────────────────────────────
# Load order: core extensions (Brain loads as a sibling module inside
# extensions/index.ts) → additional plugins → core skills
exec pi --extension "$WAYWISER_PKG_DIR/extensions/index.ts" \
   "${PLUGIN_ARGS[@]}" \
   --skill "$WAYWISER_PKG_DIR/skills/waywiser/SKILL.md" \
   --skill "$WAYWISER_PKG_DIR/skills/brain/SKILL.md" \
   "$@"
